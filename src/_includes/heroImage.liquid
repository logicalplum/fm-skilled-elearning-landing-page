{% # assign variables for reused strings that might need to change %}
{% assign prefix = 'assets/images/hero-image' %}
{% assign desktop = '1024px' %}
{% assign tablet = '640px' %}
<picture>
  <source
    media="(min-width: {{ desktop }})"
    type="image/webp"
    srcset="{{ prefix }}-desktop.webp, {{ prefix }}-desktop@2x.webp 2x"
  />
  <source
    media="(min-width: {{ desktop }})"
    type="image/jpeg"
    srcset="{{ prefix }}-desktop.jpg, {{ prefix }}-desktop@2x.jpg 2x"
  />
  <source
    media="(min-width: {{ tablet }})"
    type="image/webp"
    srcset="{{ prefix }}-tablet.webp, {{ prefix }}-tablet@2x.webp 2x"
  />
  <source
    media="(min-width: {{ tablet }})"
    type="image/jpeg"
    srcset="{{ prefix }}-tablet.jpg, {{ prefix }}-tablet@2x.jpg 2x"
  />
  <source
    type="image/webp"
    srcset="{{ prefix }}-mobile.webp, {{ prefix }}-mobile@2x.webp 2x"
  />
  <source
    type="image/jpeg"
    srcset="{{ prefix }}-mobile.jpg, {{ prefix }}-mobile@2x.jpg 2x"
  />
  <img
    src="{{ prefix }}-mobile@2x.jpg"
    alt="Woman sipping hot drink while studying laptop and text bubbles “29k members” and “1451 course hours”"
  />
</picture>


