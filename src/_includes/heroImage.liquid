{% # assign variables for reused strings that might need to change %}
{% assign prefix = 'assets/images/image-hero' %}
{% assign desktop = '1440px' %}
{% assign tablet = '768px' %}
<picture>
  <source
    media="(min-width: {{ desktop }})"
    type="image/webp"
    srcset="{{ prefix }}-desktop.webp, {{ prefix }}-desktop@2x.webp 2x"
  />
  <source
    media="(min-width: {{ desktop }})"
    type="image/png"
    srcset="{{ prefix }}-desktop.png, {{ prefix }}-desktop@2x.png 2x"
  />
  <source
    media="(min-width: {{ tablet }})"
    type="image/webp"
    srcset="{{ prefix }}-tablet.webp, {{ prefix }}-tablet@2x.webp 2x"
  />
  <source
    media="(min-width: {{ tablet }})"
    type="image/png"
    srcset="{{ prefix }}-tablet.png, {{ prefix }}-tablet@2x.png 2x"
  />
  <source
    type="image/webp"
    srcset="{{ prefix }}-mobile.webp, {{ prefix }}-mobile@2x.webp 2x"
  />
  <source
    type="image/png"
    srcset="{{ prefix }}-mobile.png, {{ prefix }}-mobile@2x.png 2x"
  />
  <img
    src="{{ prefix }}-mobile@2x.png"
    alt="Woman sipping hot drink while studying laptop and text bubbles “29k members” and “1451 course hours”"
  />
</picture>
